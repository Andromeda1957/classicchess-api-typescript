{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "moduleDetection": "legacy",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "rootDir": "examples/electron",
    "newLine": "lf",
    "noEmit": false
  },
  "files": [
    "examples/electron/electron-api.d.cts",
    "examples/electron/bridge.cts",
    "examples/electron/main.cts",
    "examples/electron/preload.cts"
  ]
}
