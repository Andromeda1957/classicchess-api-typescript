{
  "name": "classicchess-sdk",
  "version": "0.1.3",
  "description": "Typed Classic Chess public archive client for Node.js and Electron",
  "license": "MIT",
  "homepage": "https://classicchess.com/api/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Andromeda1957/classicchess-api-typescript.git"
  },
  "bugs": {
    "url": "https://github.com/Andromeda1957/classicchess-api-typescript/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "./dist/cjs/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "examples"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "build:examples": "node scripts/build-examples.ts",
    "check:examples": "node scripts/build-examples.ts --check",
    "typecheck": "npm run codegen:install && tsc -p tsconfig.scripts.json && tsc -p codegen/tsconfig.json",
    "test": "npm run check:contract && npm run build && npm run check:examples && tsc -p tsconfig.test.json && npm run typecheck && node --test tests/*.test.ts",
    "generate:types": "npm run codegen:install && node codegen/generate.ts",
    "check:contract": "npm run codegen:install && node codegen/generate.ts --check",
    "prepack": "npm run build",
    "prepare": "npm run build",
    "codegen:install": "npm ci --prefix codegen --workspaces=false --no-audit --no-fund --silent"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
